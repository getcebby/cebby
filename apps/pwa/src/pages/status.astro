---
// Public health of Cebby's event imports, grouped by source. Server-rendered,
// no client script: the user's grok-bot routine reads this page on a schedule
// and alerts on the "Noticed:" times against "Updated:". Data comes from the
// anon-safe get_scraper_status() and get_scraper_history() RPCs; the words live
// in src/lib/scraper-status.ts. The bars open native popovers (popovertarget),
// so they can be inspected by tap or keyboard without a script. The page says
// what is affected, never why: causes are in the admin app.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import SEO from '../components/SEO.astro';
import { supabase } from '../lib/supabase';
import {
    groupBySource,
    loadScraperHistory,
    loadScraperStatus,
    overallTone,
    summarize,
    updatedLine,
} from '../lib/scraper-status';

// get_scraper_status and get_scraper_history aren't in the generated Database types yet.
// The bars are extra: if their history doesn't load, the page shows without them.
const [rows, history] = await Promise.all([
    loadScraperStatus(supabase as any),
    loadScraperHistory(supabase as any).catch(() => null),
]);
const now = new Date();

if (rows) {
    Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=60');
} else {
    // Never cache an outage, and never show "All working" without data.
    Astro.response.status = 503;
    Astro.response.headers.set('Cache-Control', 'no-store');
}

const sources = rows ? groupBySource(rows, history, now) : [];
const hasBars = sources.some((g) => g.lines.some((l) => l.bars));
const tone = rows ? overallTone(rows) : 'amber';
const description = 'Whether cebby can still find and import events from Facebook, Meetup, Luma and Eventbrite.';
---

<Layout title="Status — cebby" showFooter={true}>
    <Fragment slot="head">
        <SEO title="Status — cebby" description={description} noindex={true} />
    </Fragment>
    <AppHeader showSearch={false} />
    <main class="mx-auto max-w-2xl px-5 pb-24 pt-4">
        <header class="mb-9 px-1">
            <h1 class="flex items-center gap-3 text-[28px] font-extrabold leading-tight tracking-tight text-stone-900">
                <span class:list={['summary-dot', `summary-dot-${tone}`]} aria-hidden="true"></span>
                {rows ? summarize(rows) : 'Status unavailable'}
            </h1>
            {
                rows ? (
                    <>
                        <p class="mt-2 text-[15px] leading-relaxed text-stone-600">
                            Whether Cebby can still find and import events from each source.
                        </p>
                        <p class="mt-3 text-[13px] font-semibold text-stone-500">{updatedLine(now)}</p>
                    </>
                ) : (
                    <p class="mt-2 text-[15px] leading-relaxed text-stone-600">Cebby couldn't load its checks.</p>
                )
            }
        </header>

        {
            rows && (
                <>
                    <div class="space-y-7">
                        {sources.map((group) => (
                            <section aria-labelledby={`source-${group.source}`}>
                                <h2 id={`source-${group.source}`} class="mb-2.5 px-1 text-[13px] font-bold text-stone-500">
                                    {group.label}
                                </h2>
                                <ul class="card-tactile divide-y divide-stone-100 overflow-hidden">
                                    {group.lines.map((line, li) => (
                                        <li
                                            class:list={[
                                                'check px-5 py-4',
                                                line.problem && `problem problem-${line.tone}`,
                                                !line.bars && line.details.length === 0 && 'check-plain',
                                                line.sentence && 'check-has-sentence',
                                            ]}
                                        >
                                            <h3 class="check-label text-[15px] font-bold text-stone-900">{line.label}</h3>
                                            <p
                                                class:list={[
                                                    'check-status',
                                                    line.problem
                                                        ? ['pill-tactile', `pill-${line.tone}`]
                                                        : ['quiet-status', `quiet-status-${line.tone}`],
                                                ]}
                                            >
                                                <span class="status-dot" aria-hidden="true" />
                                                {line.status}
                                            </p>
                                            {line.sentence && (
                                                <p class="check-sentence text-[14px] font-semibold leading-snug">
                                                    {line.sentence}
                                                </p>
                                            )}
                                            {line.bars && (
                                                <div class="check-bars" role="group" aria-label={line.barsLabel}>
                                                    {line.bars.map((bar, i) => {
                                                        const id = `w-${group.source}-${li}-${i}`;
                                                        return (
                                                            <Fragment>
                                                                <button
                                                                    type="button"
                                                                    class={`bar bar-${bar.tone}`}
                                                                    popovertarget={id}
                                                                    aria-label={bar.label}
                                                                    style={`anchor-name: --${id}`}
                                                                />
                                                                <div
                                                                    popover
                                                                    id={id}
                                                                    class="bar-pop"
                                                                    style={`position-anchor: --${id}`}
                                                                >
                                                                    <p class="bar-pop-range">{bar.range}</p>
                                                                    <p class="bar-pop-result">
                                                                        <span
                                                                            class={`bar bar-${bar.tone}`}
                                                                            aria-hidden="true"
                                                                        />
                                                                        {bar.result}
                                                                    </p>
                                                                    {bar.counts && <p class="bar-pop-counts">{bar.counts}</p>}
                                                                </div>
                                                            </Fragment>
                                                        );
                                                    })}
                                                </div>
                                            )}
                                            {(line.details.length > 0 || line.note) && (
                                                <div class="check-details details space-y-0.5 text-[13px] leading-relaxed">
                                                    {line.note && <p class="check-note">{line.note}</p>}
                                                    {line.problem ? (
                                                        line.details.map((detail) => <p>{detail}</p>)
                                                    ) : (
                                                        <p>
                                                            {line.details.map((detail, di) => (
                                                                <Fragment>
                                                                    {di > 0 && ' · '}
                                                                    <span class="whitespace-nowrap">{detail}</span>
                                                                </Fragment>
                                                            ))}
                                                        </p>
                                                    )}
                                                </div>
                                            )}
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>

                    {hasBars && (
                        <div class="legend mt-9 flex flex-wrap items-center gap-x-4 gap-y-2 px-1 text-[12px] font-semibold text-stone-500">
                            <span class="text-stone-600">Bars: the last 7 days, 6 hours each, oldest on the left.</span>
                            <span class="legend-item"><span class="bar bar-pass" aria-hidden="true" />Passed</span>
                            <span class="legend-item"><span class="bar bar-partial" aria-hidden="true" />Partly failed</span>
                            <span class="legend-item"><span class="bar bar-fail" aria-hidden="true" />Failed</span>
                            <span class="legend-item"><span class="bar bar-missed" aria-hidden="true" />Didn't run</span>
                            <span class="legend-item"><span class="bar bar-no_sample" aria-hidden="true" />No test event</span>
                            <span class="legend-item"><span class="bar bar-none" aria-hidden="true" />No checks</span>
                            <span class="legend-item"><span class="bar bar-pending" aria-hidden="true" />In progress</span>
                        </div>
                    )}

                    <p class:list={['px-1 text-[13px] leading-relaxed text-stone-500', hasBars ? 'mt-3' : 'mt-9']}>
                        Links are checked every hour, and finding new events runs every 6 hours. Tap or click a bar
                        for its checks. "Noticed" is when a problem first showed on this page. Times are Philippine
                        time (PHT).
                    </p>

                    <p class="mt-6 px-1 text-sm text-stone-500">
                        Missing a platform?{' '}
                        <button
                            type="button"
                            data-open-feedback
                            data-feedback-prompt="Which platform? A link to a Cebu tech group or event on it helps us add it."
                            class="font-semibold text-stone-700 underline-offset-4 transition-colors hover:text-purple-700 hover:underline"
                        >
                            Suggest one
                        </button>
                    </p>
                </>
            )
        }
    </main>
</Layout>

<style>
    /* Still dots, never pulsing (.impeccable.md: ambient motion off). */
    .summary-dot {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
        border-radius: 999px;
    }
    .summary-dot-emerald {
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.16);
    }
    .summary-dot-amber {
        background: #f59e0b;
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.18);
    }
    .summary-dot-rose {
        background: #e11d48;
        box-shadow: 0 0 0 4px rgba(225, 29, 72, 0.14);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        flex-shrink: 0;
        border-radius: 999px;
        background: currentColor;
    }

    /* Healthy lines stay quiet so a problem's pill is what the eye lands on. */
    .quiet-status {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
    }
    .quiet-status-emerald {
        color: #047857;
    }
    .quiet-status-stone {
        color: #78716c;
    }

    /* One check: name and status on top; on phones the bars run full width
       under them, on wider screens they sit under the status at a fixed width
       so every row's windows line up in the same columns. */
    .check {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
            'label status'
            'bars bars'
            'details details';
        align-items: center;
        column-gap: 1rem;
        row-gap: 0.6rem;
    }
    .check-plain {
        grid-template-areas: 'label status';
    }
    .check-has-sentence {
        grid-template-areas:
            'label status'
            'sentence sentence'
            'bars bars'
            'details details';
    }
    .check-sentence {
        grid-area: sentence;
        margin-top: -0.25rem;
    }
    .check-label {
        grid-area: label;
    }
    .check-status {
        grid-area: status;
        justify-self: end;
    }
    .check-bars {
        grid-area: bars;
    }
    .check-details {
        grid-area: details;
        align-self: start;
    }
    @media (min-width: 640px) {
        .check {
            grid-template-areas:
                'label status'
                'details bars';
            column-gap: 1.5rem;
            row-gap: 0.4rem;
        }
        .check-has-sentence {
            grid-template-areas:
                'label status'
                'sentence sentence'
                'details bars';
        }
        .check-bars {
            width: 280px;
            justify-self: end;
            align-self: start;
            margin-top: 2px;
        }
    }

    .check-bars {
        display: grid;
        grid-template-columns: repeat(28, minmax(0, 1fr));
        gap: 3px;
        height: 22px;
    }
    .bar {
        display: block;
        border-radius: 999px;
        transition: transform 160ms cubic-bezier(0.2, 0, 0, 1);
    }
    button.bar {
        min-width: 0;
        border: 0;
        padding: 0;
        cursor: pointer;
    }
    .check-bars .bar:hover,
    .check-bars .bar:focus-visible {
        transform: scaleY(1.18);
    }
    .check-bars .bar:focus-visible {
        outline: 2px solid #44403c;
        outline-offset: 2px;
    }
    @media (prefers-reduced-motion: reduce) {
        .bar {
            transition: none;
        }
        .check-bars .bar:hover,
        .check-bars .bar:focus-visible {
            transform: none;
        }
    }

    /* A bar's checks. Native popover: centred by the browser where CSS anchor
       positioning isn't supported, otherwise just above its bar. */
    .bar-pop {
        width: max-content;
        max-width: min(17rem, calc(100vw - 2rem));
        margin: auto;
        border: 0;
        border-radius: 14px;
        padding: 0.65rem 0.8rem;
        background: #ffffff;
        color: #44403c;
        font-size: 13px;
        line-height: 1.45;
        box-shadow:
            0 1px 2px rgba(41, 37, 36, 0.08),
            0 10px 24px -8px rgba(41, 37, 36, 0.28);
    }
    .bar-pop::backdrop {
        background: transparent;
    }
    @supports (anchor-name: --a) {
        .bar-pop {
            inset: auto;
            margin: 0 0 8px;
            /* Recent windows sit at the right end, so open leftwards first. */
            position-area: top span-left;
            position-try-fallbacks:
                top span-right,
                bottom span-left,
                bottom span-right;
        }
    }
    .bar-pop-range {
        font-weight: 700;
        color: #292524;
    }
    .bar-pop-result {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
    }
    .bar-pop-result .bar {
        width: 6px;
        height: 12px;
    }
    .bar-pop-counts {
        color: #57534e;
    }
    .bar-pass {
        background: linear-gradient(180deg, #6ee7b7 0%, #10b981 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }
    .bar-partial {
        background: linear-gradient(180deg, #fde68a 0%, #f59e0b 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }
    .bar-fail {
        background: linear-gradient(180deg, #fda4af 0%, #e11d48 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }
    .bar-no_sample {
        background: linear-gradient(180deg, #e7e5e4 0%, #a8a29e 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }
    .bar-none {
        background: rgba(120, 113, 108, 0.13);
    }
    .bar-pending {
        background: transparent;
        box-shadow: inset 0 0 0 1px rgba(120, 113, 108, 0.28);
    }
    /* Started but never reported: the "no checks" tint with a dashed edge. */
    .bar-missed {
        background: rgba(120, 113, 108, 0.1);
        outline: 1px dashed rgba(120, 113, 108, 0.55);
        outline-offset: -1px;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .legend-item .bar {
        width: 6px;
        height: 14px;
    }

    .details {
        color: #78716c;
    }
    .problem-rose {
        background: linear-gradient(180deg, rgba(255, 241, 242, 0.95) 0%, rgba(255, 241, 242, 0.55) 100%);
    }
    .problem-rose .details {
        color: #9f1239;
    }
    .problem-amber {
        background: linear-gradient(180deg, rgba(255, 251, 235, 0.95) 0%, rgba(255, 251, 235, 0.55) 100%);
    }
    .problem-amber .details {
        color: #92400e;
    }
    .problem-rose .check-sentence {
        color: #881337;
    }
    .problem-amber .check-sentence {
        color: #78350f;
    }
    .check-note {
        color: #57534e;
    }
</style>
