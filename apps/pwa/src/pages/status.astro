---
// Public health of Cebby's event imports, grouped by source. Server-rendered,
// no client script: the user's grok-bot routine reads this page on a schedule
// and alerts on the "Noticed:" times against "Updated:". Data comes from the
// anon-safe get_scraper_status() and get_scraper_history() RPCs; the words live
// in src/lib/scraper-status.ts. The bars open native popovers (popovertarget),
// so they can be inspected by tap or keyboard without a script. The page says
// what is affected, never why or how many: causes and counts are in the admin app.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import SEO from '../components/SEO.astro';
import { supabase } from '../lib/supabase';
import {
    groupBySource,
    legendItems,
    loadScraperHistory,
    loadScraperStatus,
    overallTone,
    summarize,
    updatedLine,
} from '../lib/scraper-status';

// get_scraper_status and get_scraper_history aren't in the generated Database types yet.
// The bars are extra: if their history doesn't load, the page shows without them.
const [rows, history] = await Promise.all([
    loadScraperStatus(supabase as any),
    loadScraperHistory(supabase as any).catch(() => null),
]);
const now = new Date();

if (rows) {
    Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=60');
} else {
    // Never cache an outage, and never show "All working" without data.
    Astro.response.status = 503;
    Astro.response.headers.set('Cache-Control', 'no-store');
}

const sources = rows ? groupBySource(rows, history, now) : [];
const legend = legendItems(sources.flatMap((g) => g.lines.map((l) => l.bars)));
const tone = rows ? overallTone(rows) : 'amber';
const description = 'Whether cebby can still find and import events from Facebook, Meetup, Luma and Eventbrite.';
---

<Layout title="Status — cebby" showFooter={true}>
    <Fragment slot="head">
        <SEO title="Status — cebby" description={description} noindex={true} />
    </Fragment>
    <AppHeader showSearch={false} />
    <main class="mx-auto max-w-2xl px-5 pb-24 pt-4">
        <header class="mb-9 px-1">
            <h1 class="flex items-center gap-3 text-[28px] font-extrabold leading-tight tracking-tight text-stone-900">
                <span class:list={['summary-dot', `summary-dot-${tone}`]} aria-hidden="true"></span>
                {rows ? summarize(rows) : 'Status unavailable'}
            </h1>
            {
                rows ? (
                    <>
                        <p class="mt-2 text-[15px] leading-relaxed text-stone-600">
                            Whether Cebby can still find and import events from each source.
                        </p>
                        <p class="mt-3 text-[13px] font-semibold text-stone-500">{updatedLine(now)}</p>
                    </>
                ) : (
                    <p class="mt-2 text-[15px] leading-relaxed text-stone-600">Cebby couldn't load its checks.</p>
                )
            }
        </header>

        {
            rows && (
                <>
                    {legend.length > 0 && (
                        <p class="legend -mt-4 mb-7 flex flex-wrap items-center gap-x-3.5 gap-y-1.5 px-1 text-[12px] font-semibold text-stone-500">
                            <span class="text-stone-600">Last 7 days, 6 hours per bar:</span>
                            {legend.map((item) => (
                                <span class="legend-item">
                                    <span class={`bar bar-${item.tone}`} aria-hidden="true" />
                                    {item.label}
                                </span>
                            ))}
                        </p>
                    )}

                    <div class="space-y-7">
                        {sources.map((group) => (
                            <section aria-labelledby={`source-${group.source}`}>
                                <h2 id={`source-${group.source}`} class="mb-2.5 px-1 text-[13px] font-bold text-stone-500">
                                    {group.label}
                                </h2>
                                <ul class="card-tactile divide-y divide-stone-100 overflow-hidden">
                                    {group.lines.map((line, li) => (
                                        <li class:list={['check px-5 py-4', line.problem && `problem problem-${line.tone}`]}>
                                            <div class="check-head">
                                                <h3 class="text-[15px] font-bold text-stone-900">{line.label}</h3>
                                                <p
                                                    class:list={[
                                                        'shrink-0',
                                                        line.problem
                                                            ? ['pill-tactile', `pill-${line.tone}`]
                                                            : ['quiet-status', `quiet-status-${line.tone}`],
                                                    ]}
                                                >
                                                    <span class="status-dot" aria-hidden="true" />
                                                    {line.status}
                                                </p>
                                            </div>
                                            {line.sentence && (
                                                <p class="check-sentence text-[15px] font-medium leading-snug text-stone-900">
                                                    {line.sentence}
                                                </p>
                                            )}
                                            {line.bars && (
                                                <div class="check-bars" role="group" aria-label={line.barsLabel}>
                                                    {line.bars.map((bar, i) => {
                                                        const id = `w-${group.source}-${li}-${i}`;
                                                        return (
                                                            <Fragment>
                                                                <button
                                                                    type="button"
                                                                    class={`bar bar-${bar.tone}`}
                                                                    popovertarget={id}
                                                                    aria-label={bar.label}
                                                                    style={`anchor-name: --${id}`}
                                                                />
                                                                <div
                                                                    popover
                                                                    id={id}
                                                                    class="bar-pop"
                                                                    style={`position-anchor: --${id}`}
                                                                >
                                                                    <p class="bar-pop-range">{bar.range}</p>
                                                                    <p class="bar-pop-result">
                                                                        <span
                                                                            class={`bar bar-${bar.tone}`}
                                                                            aria-hidden="true"
                                                                        />
                                                                        {bar.result}
                                                                    </p>
                                                                </div>
                                                            </Fragment>
                                                        );
                                                    })}
                                                </div>
                                            )}
                                            {(line.note || line.times.length > 0) && (
                                                <div class="check-meta text-[13px] leading-relaxed text-stone-500">
                                                    {line.note && <p class="text-stone-600">{line.note}</p>}
                                                    {line.times.length > 0 && (
                                                        <div class="times">
                                                            <p>
                                                                {line.times.map((time) => (
                                                                    // One line: whitespace here would indent each item.
                                                                    <span class="time"><span class="sep" aria-hidden="true">{' · '}</span>{time}</span>
                                                                ))}
                                                            </p>
                                                        </div>
                                                    )}
                                                </div>
                                            )}
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>

                    <p class="mt-9 px-1 text-[13px] leading-relaxed text-stone-500">
                        Links are checked every hour, and finding new events runs every 6 hours. Tap or click a bar
                        for its time and result. "Noticed" is when a problem first showed on this page. Times are
                        Philippine time (PHT).
                    </p>

                    <p class="mt-6 px-1 text-sm text-stone-500">
                        Missing a platform?{' '}
                        <button
                            type="button"
                            data-open-feedback
                            data-feedback-prompt="Which platform? A link to a Cebu tech group or event on it helps us add it."
                            class="font-semibold text-stone-700 underline-offset-4 transition-colors hover:text-purple-700 hover:underline"
                        >
                            Suggest one
                        </button>
                    </p>
                </>
            )
        }
    </main>
</Layout>

<style>
    /* Still dots, never pulsing (.impeccable.md: ambient motion off). */
    .summary-dot {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
        border-radius: 999px;
    }
    .summary-dot-emerald {
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.16);
    }
    .summary-dot-amber {
        background: #f59e0b;
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.18);
    }
    .summary-dot-rose {
        background: #e11d48;
        box-shadow: 0 0 0 4px rgba(225, 29, 72, 0.14);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        flex-shrink: 0;
        border-radius: 999px;
        background: currentColor;
    }

    /* Healthy lines stay quiet so a problem's pill is what the eye lands on. */
    .quiet-status {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
    }
    .quiet-status-emerald {
        color: #047857;
    }
    .quiet-status-stone {
        color: #78716c;
    }

    /* One check, top to bottom: name and status, a problem's sentence, the
       bars at full width (every row's windows share the same columns), then
       one muted line of times. */
    .check {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }
    .check-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .check-sentence {
        margin-top: -0.25rem;
    }

    /* "Label: time" items joined by dots. Each item wraps only as a whole
       (alone on a line when it must), and the dot before the first item on
       every line is clipped, so a line never starts or ends with one. */
    .times {
        overflow: hidden;
    }
    .times > p {
        display: flex;
        flex-wrap: wrap;
        margin-left: -1.1em;
    }
    .time {
        min-width: 0;
    }
    .sep {
        display: inline-block;
        width: 1.1em;
        text-align: center;
    }

    .check-bars {
        display: grid;
        grid-template-columns: repeat(28, minmax(0, 1fr));
        gap: 2px;
        height: 32px;
    }
    @media (min-width: 640px) {
        .check-bars {
            gap: 3px;
            height: 30px;
        }
    }
    .bar {
        display: block;
        border-radius: 4px;
        transition:
            filter 160ms cubic-bezier(0.2, 0, 0, 1),
            transform 160ms cubic-bezier(0.2, 0, 0, 1);
    }
    button.bar {
        min-width: 0;
        border: 0;
        padding: 0;
        cursor: pointer;
    }
    .check-bars .bar:hover {
        filter: brightness(0.93);
    }
    .check-bars .bar:active {
        transform: scale(0.94);
    }
    /* The bar whose popover is open, as in a selected tab. */
    .check-bars .bar:has(+ .bar-pop:popover-open) {
        outline: 2px solid #44403c;
        outline-offset: 1px;
    }
    .check-bars .bar:focus-visible {
        outline: 2px solid #9333ea;
        outline-offset: 2px;
    }
    @media (prefers-reduced-motion: reduce) {
        .bar {
            transition: none;
        }
        .check-bars .bar:active {
            transform: none;
        }
    }

    /* A bar's window and result. Native popover: centred by the browser where
       CSS anchor positioning isn't supported, otherwise just above its bar. */
    .bar-pop {
        width: max-content;
        max-width: min(17rem, calc(100vw - 2rem));
        margin: auto;
        border: 0;
        border-radius: 14px;
        padding: 0.65rem 0.8rem;
        background: #ffffff;
        color: #44403c;
        font-size: 13px;
        line-height: 1.45;
        box-shadow:
            0 1px 2px rgba(41, 37, 36, 0.08),
            0 10px 24px -8px rgba(41, 37, 36, 0.28);
    }
    .bar-pop::backdrop {
        background: transparent;
    }
    @supports (anchor-name: --a) {
        .bar-pop {
            inset: auto;
            margin: 0 0 8px;
            /* Recent windows sit at the right end, so open leftwards first. */
            position-area: top span-left;
            position-try-fallbacks:
                top span-right,
                bottom span-left,
                bottom span-right;
        }
    }
    .bar-pop-range {
        font-weight: 700;
        color: #292524;
    }
    .bar-pop-result {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
    }
    .bar-pop-result .bar {
        width: 6px;
        height: 12px;
        border-radius: 2px;
    }

    .bar-pass {
        background: linear-gradient(180deg, #6ee7b7 0%, #10b981 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }
    .bar-partial {
        background: linear-gradient(180deg, #fde68a 0%, #f59e0b 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }
    .bar-fail {
        background: linear-gradient(180deg, #fda4af 0%, #e11d48 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }
    /* No result to show: nothing ran, no test event, or still running. One
       colour, one legend entry ("No data"); the popover names which. */
    .bar-none,
    .bar-no_sample,
    .bar-pending {
        background: rgba(120, 113, 108, 0.14);
    }
    /* Started but never reported: the "no data" tint with a dashed edge. */
    .bar-missed {
        background: rgba(120, 113, 108, 0.1);
        outline: 1px dashed rgba(120, 113, 108, 0.6);
        outline-offset: -1px;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .legend-item .bar {
        width: 7px;
        height: 14px;
        border-radius: 2px;
    }

    /* A problem's row carries a faint wash of its tone; the colour lives in
       the pill and the bars, and the text stays ink and muted stone. */
    .problem-rose {
        background: linear-gradient(180deg, rgba(255, 241, 242, 0.75) 0%, rgba(255, 241, 242, 0.3) 100%);
    }
    .problem-amber {
        background: linear-gradient(180deg, rgba(255, 251, 235, 0.75) 0%, rgba(255, 251, 235, 0.3) 100%);
    }
</style>
