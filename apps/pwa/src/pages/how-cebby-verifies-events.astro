---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import SEO from '../components/SEO.astro';

const metaDescription =
    'How Cebby checks Cebu tech event listings, shows sources, and handles corrections.';

const checks = [
    {
        label: 'Source first',
        text: 'Every listing should point back to where Cebby found it: Luma, Meetup, Facebook, Eventbrite, an organizer page, or a community source.',
    },
    {
        label: 'Freshness matters',
        text: 'Imported events keep a last-checked timestamp from the source row. Fresh checks are more useful than a large stale feed.',
    },
    {
        label: 'Trust is labeled',
        text: 'Badges separate signed Cebby partnerships, vouched organizers, official sources, imports, community sources, and listings that still need review.',
    },
    {
        label: 'Corrections stay easy',
        text: 'If a date, location, source, cancellation, or duplicate looks wrong, the event page has structured report buttons.',
    },
];

const badges = [
    ['Cebby partner', 'The organizer has a signed Cebby partnership. These events get Cebby\'s strongest trust signal.'],
    ['Trusted organizer', 'Cebby knows and vouches for the organizer, even if the source link came through Luma, Meetup, Facebook, or another platform.'],
    ['Official source', 'The listing comes from a source the organizer controls, like an official event page or platform profile. Cebby still shows the link so you can check it.'],
    ['Imported', 'Cebby found the event from a public source and links back to it.'],
    ['Community source', 'The listing came from a manual or community-submitted source.'],
    ['Needs review', 'The listing is missing a checkable public source or needs more attention.'],
];

interface ReliabilityMetrics {
    generated_at: string | null;
    latest_checked_at: string | null;
    total_upcoming_events: number;
    sourced_upcoming_events: number;
    sourced_percent: number;
    multi_source_upcoming_events: number;
    multi_source_percent: number;
    partner_upcoming_events: number | null;
    partner_percent: number | null;
    trusted_organizer_upcoming_events: number;
    trusted_organizer_percent: number;
    checked_24h_upcoming_events: number;
    checked_24h_percent: number;
    no_source_upcoming_events: number;
}

let metrics: ReliabilityMetrics | null = null;
try {
    const response = await fetch(new URL('/api/reliability-metrics', Astro.url));
    if (response.ok) {
        const payload = await response.json() as { available?: boolean; metrics?: ReliabilityMetrics | null };
        metrics = payload.available ? payload.metrics ?? null : null;
    }
} catch (error) {
    console.warn('[verify-events] reliability metrics unavailable:', error);
}

function fmtDate(iso: string | null): string {
    if (!iso) return 'not recorded yet';
    const date = new Date(iso);
    if (Number.isNaN(date.getTime())) return iso;
    return date.toLocaleString('en-US', {
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        timeZone: 'Asia/Manila',
    });
}

const metricCards = metrics
    ? [
        {
            value: `${metrics.sourced_percent}%`,
            label: 'with source links',
            note: `${metrics.sourced_upcoming_events}/${metrics.total_upcoming_events} upcoming events`,
        },
        {
            value: `${metrics.partner_percent ?? 0}%`,
            label: 'Cebby partners',
            note: `${metrics.partner_upcoming_events ?? 0} upcoming events`,
        },
        {
            value: `${metrics.trusted_organizer_percent}%`,
            label: 'trusted organizers',
            note: `${metrics.trusted_organizer_upcoming_events} upcoming events`,
        },
        {
            value: `${metrics.checked_24h_percent}%`,
            label: 'checked in 24h',
            note: `latest check ${fmtDate(metrics.latest_checked_at)}`,
        },
        {
            value: `${metrics.multi_source_percent}%`,
            label: 'multi-source',
            note: `${metrics.multi_source_upcoming_events} cross-posted events`,
        },
    ]
    : [];
---

<Layout title="How Cebby verifies events - cebby" showFooter={true}>
    <Fragment slot="head">
        <SEO title="How Cebby verifies events - cebby" description={metaDescription} />
    </Fragment>

    <AppHeader showSearch={false} />

    <main class="mx-auto max-w-3xl px-5 pb-20 pt-2">
        <section class="mb-8">
            <p class="mb-2 text-[10px] font-bold uppercase tracking-widest text-gray-500">Trust</p>
            <h1 class="text-2xl font-extrabold text-gray-900">How Cebby verifies events</h1>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-600">
                Cebby is a discovery layer, not the event organizer. The goal is to make each listing easy to verify:
                where it came from, how recently it was checked, and what to do if something looks wrong.
            </p>
        </section>

        {metrics && (
            <section class="mb-10">
                <div class="mb-3 flex items-end justify-between gap-3">
                    <div>
                        <h2 class="text-lg font-bold text-gray-900">Current reliability snapshot</h2>
                        <p class="mt-1 text-xs leading-relaxed text-gray-500">
                            Aggregated from upcoming published events. Updated as the source data changes.
                        </p>
                    </div>
                    <p class="shrink-0 text-right text-[10px] font-bold uppercase tracking-widest text-gray-400">
                        {fmtDate(metrics.generated_at)}
                    </p>
                </div>
                <div class="grid gap-3 sm:grid-cols-4">
                    {metricCards.map((item) => (
                        <article class="card-tactile p-4">
                            <div class="text-2xl font-extrabold text-gray-900">{item.value}</div>
                            <div class="mt-1 text-xs font-extrabold uppercase tracking-wide text-gray-500">{item.label}</div>
                            <p class="mt-2 text-xs leading-relaxed text-gray-500">{item.note}</p>
                        </article>
                    ))}
                </div>
                {metrics.no_source_upcoming_events > 0 && (
                    <p class="mt-3 text-xs leading-relaxed text-amber-700">
                        {metrics.no_source_upcoming_events} upcoming event{metrics.no_source_upcoming_events === 1 ? '' : 's'} still need source review.
                    </p>
                )}
            </section>
        )}

        <section class="grid gap-3 sm:grid-cols-2">
            {checks.map((item) => (
                <article class="card-tactile p-5">
                    <h2 class="mb-2 text-base font-extrabold text-gray-900">{item.label}</h2>
                    <p class="text-sm leading-relaxed text-gray-500">{item.text}</p>
                </article>
            ))}
        </section>

        <section class="mt-10">
            <h2 class="mb-3 text-lg font-bold text-gray-900">What the badges mean</h2>
            <div class="grid gap-3">
                {badges.map(([label, text]) => (
                    <div class="card-tactile grid gap-2 p-4 sm:grid-cols-[11rem_1fr] sm:items-center">
                        <span class="text-sm font-extrabold text-gray-900">{label}</span>
                        <p class="text-sm leading-relaxed text-gray-500">{text}</p>
                    </div>
                ))}
            </div>
        </section>

        <section class="mt-10 border-t border-gray-200 pt-6">
            <h2 class="mb-2 text-base font-extrabold text-gray-900">The standard</h2>
            <p class="text-sm leading-relaxed text-gray-600">
                A smaller accurate feed is better than a bigger noisy one. Cebby should earn trust by making the
                evidence visible, not by asking users to trust the brand.
            </p>
        </section>
    </main>
</Layout>
